    ///
    public Optional<Pacientes> buscarPorId(Integer id) {
        return pacientesRepository.findById(id);
    }

    public Map<String, String> obtenerPacientePorId(Integer id) {
        Optional<Pacientes> pacienteOpt = pacientesRepository.findById(id);
        Map<String, String> pacienteData = new HashMap<>();

        System.out.println("Buscando paciente con ID: " + id);  // Verificar que el DNI recibido es correcto

        if (pacienteOpt.isPresent()){
            Pacientes paciente = pacienteOpt.get();
            System.out.println("Paciente encontrado con ID: " + paciente.getIdPaciente());

            pacienteData.put("id", String.valueOf(paciente.getIdPaciente()));
            pacienteData.put("nombre", paciente.getNombre());
            pacienteData.put("apellido", paciente.getApellido());

        }else {
            pacienteData.put("error", "Paciente no encontrado");
        }

        return pacienteData;
    }

}
